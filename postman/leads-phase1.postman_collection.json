{
  "info": {
    "name": "FinMarket Member 2 \u2014 Leads Phase I",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "leadId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create lead",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"advisorId\": \"507f1f77bcf86cd799439011\",\n  \"name\": \"Jane Example\",\n  \"email\": \"jane@example.com\",\n  \"interest\": \"Retirement planning\",\n  \"marketingConsent\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"leadId\", pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List consenting new leads",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads?status=NEW&marketingConsent=true"
      }
    },
    {
      "name": "Get lead",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads/{{leadId}}"
      }
    },
    {
      "name": "Update lead",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads/{{leadId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONTACTED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Withdraw consent",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads/{{leadId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marketingConsent\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Invalid email (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/leads",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"advisorId\": \"507f1f77bcf86cd799439011\",\n  \"name\": \"Jane Example\",\n  \"email\": \"invalid\",\n  \"interest\": \"Retirement planning\",\n  \"marketingConsent\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
